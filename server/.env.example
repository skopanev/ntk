# Шаблон. Рабочие значения живут в /etc/ntk/*.env на дроплете с правами 600
# и в репозиторий не попадают никогда.

# --- api.env ---
DATABASE_URL=postgres://ntk_api:ЗАМЕНИ@localhost:5432/ntk
PORT=8080
# Публичный адрес сервиса. ОБЯЗАТЕЛЕН: из него строятся адреса в
# .well-known и redirect_uri для Google, и по ним ходит Claude.
# Без него сервис не поднимется — это лучше, чем поднимется и будет врать.
PUBLIC_URL=https://ЗАМЕНИ

# --- backup.env ---
SPACES_BUCKET=ntk-storage
SPACES_ENDPOINT=https://ams3.digitaloceanspaces.com
SPACES_REGION=ams3
AWS_ACCESS_KEY_ID=ЗАМЕНИ
AWS_SECRET_ACCESS_KEY=ЗАМЕНИ
RETENTION_DAYS=30
