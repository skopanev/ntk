node_modules/
.DS_Store
.ntkrc
.medulla/panel-runs/
.claude/settings.local.json

# Rust
target/

# Снимки Notion — рабочие данные, не исходники
notion-*.jsonl
snapshot-*.jsonl

# Бандл и распакованное дерево — артефакты сборки
dist/*.mcpb
dist/mcpb/server/

# Секреты и адреса — никогда в репозиторий.
#
# Репозиторий публичный, а .env держит то, что из него намеренно убрано: адрес
# дроплета, машину с ключом подписи, личность подписанта. Строка стоит здесь
# ДО того, как файл появился: иначе от коммита его отделяет только внимательность
# в момент `git add -A`.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.crt
