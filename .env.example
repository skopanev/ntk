# Шаблон. Рабочие значения живут в .env рядом — он в .gitignore и в
# репозиторий не попадает никогда.
#
#   cp .env.example .env && $EDITOR .env
#   set -a; . ./.env; set +a; ./release.sh

# --- выкатка сервиса и выпуск клиента ---
# Дроплет: куда rsync-ит исходники, где собирается linux-бинарь и ntk-api.
NTK_HOST=root@192.0.2.10

# --- подпись macOS-бинаря (release.sh -> sign-macos.sh) ---
# Машина, где живёт приватный ключ. Ключ не размножается по машинам:
# бинарь уезжает туда и возвращается подписанным.
SIGN_HOST=имя-машины-из-ssh-config
# Личность подписи ровно как её печатает `security find-identity -v -p codesigning`.
SIGN_ID=Developer ID Application: Имя Фамилия (TEAMID)
# Файл НА МАШИНЕ ПОДПИСИ с кредами нотаризации: APPLE_ID, APPLE_PASSWORD,
# APPLE_TEAM_ID и, если связка заперта, KEYCHAIN_PASSWORD.
SIGN_ENV=~/.config/ntk/sign.env
